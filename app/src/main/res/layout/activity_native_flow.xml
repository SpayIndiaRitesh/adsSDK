<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_native_flow_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Native Ads - Level 1 of 3"
            android:textColor="#202124"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_native_flow_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Testing instant Native Ad preloading across multi-level screens."
            android:textColor="#5F6368"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_native_flow_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Native Ad Status: Ready"
            android:textColor="#1A73E8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Level 1 & 3: Small Native Ad -->
        <com.example.ads.nativead.NativeAdViewContainer
            android:id="@+id/native_ad_flow_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:autoLoadNative="true"
            app:nativeTemplate="small" />

        <!-- Level 2 & 3: Medium Native Ad -->
        <com.example.ads.nativead.NativeAdViewContainer
            android:id="@+id/native_ad_flow_medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:autoLoadNative="true"
            app:nativeTemplate="medium" />

        <!-- Action Buttons -->
        <Button
            android:id="@+id/btn_next_native_level"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="Proceed to Level 2 ➔" />

        <Button
            android:id="@+id/btn_native_back_home"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="Exit Flow / Back to Home" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
